# Copy to .env and configure locally. Never commit a real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MAX_CALLS=18
OPENAI_MAX_USD=2
OPENAI_MAX_SECONDS=180
# Conservative accounting rates, not vendor price quotes. Adjust for your model.
OPENAI_INPUT_USD_PER_MILLION=10
OPENAI_OUTPUT_USD_PER_MILLION=40
